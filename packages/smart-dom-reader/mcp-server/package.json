{
  "name": "@mcp-b/smart-dom-reader-server",
  "version": "5.0.1",
  "description": "MCP server for smart-dom-reader backed by Playwright",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebMCP-org/npm-packages.git",
    "directory": "packages/smart-dom-reader/mcp-server"
  },
  "bin": {
    "smart-dom-reader-server": "./src/index.ts"
  },
  "files": [
    "src",
    "lib"
  ],
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "pnpm bundle",
    "bundle": "node ./scripts/update-bundle.mjs && vp fmt lib/smart-dom-reader.bundle.js --write",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "prepublishOnly": "node ../../../scripts/validate-publish.js",
    "start": "tsx src/index.ts",
    "test:e2e": "node --test test/*.test.mjs",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "playwright": "catalog:",
    "tsx": "^4.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mcp-b/smart-dom-reader": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
