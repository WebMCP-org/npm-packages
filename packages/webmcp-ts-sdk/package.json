{
  "name": "@mcp-b/webmcp-ts-sdk",
  "version": "5.1.0",
  "description": "Thin WebMCP-to-MCP v2 browser adapter with native Chrome tool mirroring",
  "keywords": [
    "adapter",
    "ai-agents",
    "ai-integration",
    "anthropic",
    "browser",
    "chatgpt",
    "claude",
    "copilot",
    "cursor",
    "document-modelcontext",
    "dynamic-tools",
    "gemini",
    "llm",
    "mcp",
    "mcp-client",
    "mcp-server",
    "model-context-protocol",
    "openai",
    "sdk",
    "tool-registration",
    "typescript",
    "w3c",
    "web-model-context",
    "webmcp"
  ],
  "homepage": "https://docs.mcp-b.ai/packages/webmcp-ts-sdk/reference",
  "bugs": {
    "url": "https://github.com/WebMCP-org/npm-packages/issues"
  },
  "license": "MIT",
  "author": "Alex Nahas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebMCP-org/npm-packages.git",
    "directory": "packages/webmcp-ts-sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check --fix",
    "clean": "rm -rf dist",
    "format": "vp fmt --write",
    "lint": "vp lint --fix",
    "prepublishOnly": "node ../../scripts/validate-publish.js && pnpm run build",
    "publish:dry": "pnpm publish --access public --dry-run",
    "publish:npm": "pnpm publish --access public",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "workspace:*",
    "@mcp-b/webmcp-types": "workspace:*",
    "@modelcontextprotocol/server": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
