{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // The shared conformance suite lives outside this package, so its bare
    // imports have to resolve through this package's node_modules. Keep this
    // list exact: a wildcard here also redirects the bundler and bloats dist.
    "paths": {
      "@mcp-b/webmcp-ts-sdk": ["./node_modules/@mcp-b/webmcp-ts-sdk"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src/**/*", "conformance/**/*"],
  "exclude": ["node_modules", "dist"]
}
