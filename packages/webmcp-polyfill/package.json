{
  "name": "@mcp-b/webmcp-polyfill",
  "version": "5.1.0",
  "description": "Vendored upstream WebMCP polyfill plus temporary declarative tools",
  "keywords": [
    "browser",
    "model-context",
    "polyfill",
    "webmcp"
  ],
  "homepage": "https://docs.mcp-b.ai/packages/webmcp-polyfill/reference",
  "bugs": {
    "url": "https://github.com/WebMCP-org/npm-packages/issues"
  },
  "license": "MIT",
  "author": "Alex Nahas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebMCP-org/npm-packages.git",
    "directory": "packages/webmcp-polyfill"
  },
  "files": [
    "dist",
    "LICENSE.webmcp-polyfill"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.iife.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./iife": {
      "script": "./dist/index.iife.js",
      "default": "./dist/index.iife.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check --fix",
    "clean": "rm -rf dist",
    "format": "vp fmt --write",
    "lint": "vp lint --fix",
    "prepublishOnly": "node ../../scripts/validate-publish.js && pnpm run build",
    "publish:dry": "pnpm publish --access public --dry-run",
    "publish:npm": "pnpm publish --access public",
    "test": "vp test run",
    "test:smoke": "vp test run src/index.test.ts --browser.headless",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "webmcp-types": "0.1.10"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "upstream": {
    "repository": "https://github.com/webmachinelearning/webmcp-polyfill",
    "commit": "6bf6c57bbaf3d1173d7737cfb79572632d9b7871"
  }
}
