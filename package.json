{
  "name": "@mcp-b/npm-packages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:ci:critical": "node ./scripts/audit-filtered.mjs --level critical --prod --ignore-prefix e2e__ --ignore-prefix examples__",
    "audit:ci:high": "node ./scripts/audit-filtered.mjs --level high --prod --ignore-prefix e2e__ --ignore-prefix examples__",
    "build": "pnpm -r --filter '!@mcp-b/example-*' --filter '!@mcp-b/landing-page' run build",
    "build:docs": "pnpm --filter @mcp-b/documentation-website build",
    "build:landing": "pnpm --filter @mcp-b/landing-page build",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/release-metadata.mjs --write",
    "check": "vp check --fix",
    "check-all": "pnpm typecheck && vp check",
    "check:ci": "vp check",
    "check:packages": "node scripts/check-packages.mjs",
    "ci:publish": "pnpm release:check && RELEASE_TAG=$(node scripts/npm-dist-tag.mjs) && pnpm -r --filter './packages/**' publish --access public --no-git-checks --tag \"$RELEASE_TAG\" && pnpm exec changeset tag",
    "clean": "git clean -xdf .cache .vite node_modules",
    "deploy:landing": "pnpm --filter @mcp-b/landing-page deploy",
    "dev:docs": "pnpm --filter @mcp-b/documentation-website dev",
    "dev:landing": "pnpm --filter @mcp-b/landing-page dev",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "prepare": "vp config",
    "preview:docs": "pnpm --filter @mcp-b/documentation-website preview",
    "preview:landing": "pnpm --filter @mcp-b/landing-page preview",
    "publish:all": "pnpm run build && pnpm release:check && RELEASE_TAG=$(node scripts/npm-dist-tag.mjs) && pnpm -r --filter './packages/**' publish --access public --no-git-checks --tag \"$RELEASE_TAG\"",
    "release:check": "node scripts/release-metadata.mjs",
    "syncpack:fix": "syncpack fix-mismatches",
    "syncpack:lint": "syncpack lint",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "pnpm --filter @mcp-b/smart-dom-reader test:local && pnpm --filter @mcp-b/smart-dom-reader-server test:e2e && pnpm --filter mcp-e2e-tests run test:runtime-contract && pnpm --filter @mcp-b/webmcp-local-relay test:e2e && pnpm --filter @mcp-b/transports test:e2e && pnpm --filter @mcp-b/webmcp-extension test:e2e",
    "test:e2e:debug": "pnpm --filter mcp-e2e-tests test:debug",
    "test:e2e:frameworks": "pnpm --filter mcp-e2e-tests run test:integration:frameworks",
    "test:e2e:headed": "pnpm --filter mcp-e2e-tests test:headed",
    "test:e2e:tarball:global": "node ./scripts/test-global-tarball-e2e.mjs",
    "test:e2e:ui": "pnpm --filter mcp-e2e-tests test:ui",
    "test:hooks": "pnpm --filter usewebmcp test && pnpm --filter @mcp-b/react-webmcp test",
    "test:hooks:coverage": "pnpm --filter usewebmcp test --coverage && pnpm --filter @mcp-b/react-webmcp test --coverage",
    "test:unit": "pnpm test:unit:scripts && pnpm test:unit:packages && pnpm test:hooks",
    "test:unit:coverage": "pnpm test:unit:scripts && pnpm test:unit:packages:coverage && pnpm test:hooks:coverage",
    "test:unit:packages": "pnpm -r --filter '!@mcp-b/example-*' --filter '!@mcp-b/landing-page' --filter '!mcp-e2e-tests' --filter '!mcp-tab-transport-test-app' --filter '!usewebmcp' --filter '!@mcp-b/react-webmcp' run test",
    "test:unit:packages:coverage": "pnpm --filter @mcp-b/documentation-website --filter @mcp-b/webmcp-types test && pnpm -r --filter './packages/**' --filter '!usewebmcp' --filter '!@mcp-b/react-webmcp' run test:coverage",
    "test:unit:scripts": "node --test scripts/*.test.mjs",
    "test:wpt": "pnpm --filter @mcp-b/webmcp-polyfill build && node ./scripts/run-webmcp-wpt.mjs",
    "test:wpt:idl": "pnpm --filter @mcp-b/webmcp-polyfill build && node ./scripts/run-webmcp-wpt.mjs --idl",
    "typecheck": "pnpm -r --filter '!@mcp-b/example-*' --filter '!@mcp-b/landing-page' run typecheck",
    "validate:docs": "pnpm --filter @mcp-b/documentation-website validate",
    "validate:publish": "node ./scripts/validate-publish.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "jiti": "^2.6.1",
    "syncpack": "^13.0.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "ajv@8": "^8.18.0",
      "basic-ftp": "^5.2.0",
      "brace-expansion@5": "^5.0.9",
      "diff": "^8.0.3",
      "fast-uri@3.1.0": "^3.1.5",
      "hono": "^4.12.2",
      "immutable@5.1.4": "^5.1.8",
      "js-yaml@3": "^3.14.2",
      "js-yaml@4": "^4.3.1",
      "lodash": "^4.17.23",
      "minimatch": "^10.2.3",
      "nanoid@3.3.12": "^3.3.18",
      "picomatch@4.0.3": "^4.0.4",
      "postcss@8.5.15": "^8.5.18",
      "rollup@4": "^4.59.0",
      "svgo@4.0.1": "^4.0.2",
      "svelte@5": "^5.53.5"
    }
  }
}
