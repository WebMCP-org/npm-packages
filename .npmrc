# pnpm workspace best practices
node-linker=isolated
strict-peer-dependencies=false
link-workspace-packages=true
auto-install-peers=true
registry=https://registry.npmjs.org/

# Catalog mode: prefer catalog versions when adding dependencies
catalog-mode=prefer

# Performance optimizations
prefer-workspace-packages=true
recursive-install=true
shared-workspace-lockfile=true

# Publishing settings
publish-branch=main

# Security and stability
engine-strict=true
resolution-mode=highest

# Ensure workspace packages are always linked
dedupe-peer-dependents=false

# Git dependencies compile inside the store. TypeScript skips imported module
# emission when that path contains node_modules (including pnpm/action-setup's
# default store), which leaves the official WebMCP frame bridge incomplete.
store-dir=~/.pnpm-store
