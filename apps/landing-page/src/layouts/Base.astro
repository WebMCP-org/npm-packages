---
import Codeforge from './Codeforge.astro';
import type { ComponentProps } from 'astro/types';

type Props = ComponentProps<typeof Codeforge>;

const { title, description, image, article } = Astro.props;
---

<Codeforge {title} {description} {image} {article}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <slot />
</Codeforge>
