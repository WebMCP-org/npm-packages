{
  "name": "web-standards-showcase",
  "version": "1.0.3",
  "private": true,
  "description": "Native Chromium WebMCP showcase for registration, discovery, and execution",
  "type": "module",
  "scripts": {
    "build": "pnpm run copy:relay && tsc && vp build",
    "cf-typegen": "wrangler types",
    "copy:relay": "mkdir -p public/relay && cp ../../packages/webmcp-local-relay/dist/browser/embed.js ../../packages/webmcp-local-relay/dist/browser/widget.html public/relay/",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "pnpm run copy:relay && vp dev",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-slot": "^1.4.0",
    "@rjsf/core": "^6.11.0",
    "@rjsf/shadcn": "^6.11.0",
    "@rjsf/utils": "^6.11.0",
    "@rjsf/validator-ajv8": "^6.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "webmcp-types": "^0.1.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@mcp-b/webmcp-local-relay": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.147.0"
  }
}
